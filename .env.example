DATABASE_URL=postgresql+psycopg://evidencepilot:change_this_password@localhost:5432/evidencepilot
POSTGRES_USER=evidencepilot
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=evidencepilot
POSTGRES_PORT=5432
API_PORT=8001
STREAMLIT_PORT=8501
# For the API container only; 127.0.0.1 there is not the host.
LLM_CONTAINER_LOCAL_BASE_URL=http://host.docker.internal:8010/v1
# Optional complete DSN for a custom database or URL-encoded password in Compose.
# COMPOSE_DATABASE_URL=postgresql+psycopg://evidencepilot:change_this_password@postgres:5432/evidencepilot
# Streamlit process configuration; it reads no model/database credentials.
API_BASE_URL=http://127.0.0.1:8001

# Select exactly one inference branch; restart the API after switching.
LLM_MODE=local
LLM_LOCAL_BASE_URL=http://127.0.0.1:8010/v1
LLM_LOCAL_MODEL=/data0/liuxule/project/models/Qwen3.8-27B
LLM_LOCAL_API_KEY=
LLM_REMOTE_BASE_URL=
LLM_REMOTE_MODEL=
LLM_REMOTE_API_KEY=
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_DISABLE_THINKING=true

# Credentials are read only from the private .env; never put real keys here.
TAVILY_API_KEY=
SEARCH_TIMEOUT_SECONDS=20
SEARCH_MAX_RETRIES=2
SEARCH_MAX_QUERIES=5
WEBPAGE_TIMEOUT_SECONDS=20
WEBPAGE_MAX_BYTES=3000000
WEB_CACHE_DIR=data/cache/web

AGENT_TOOL_TIMEOUT_SECONDS=30
AGENT_MAX_STEPS=12
AGENT_MAX_RETRIEVAL_ACTIONS=6
AGENT_MAX_CLAIM_RETRIEVALS=3
AGENT_MAX_QUERY_REWRITES=2
AGENT_EVIDENCE_MAX_AGE_DAYS=365
AGENT_LEASE_SECONDS=360
AGENT_RAG_METHOD=hybrid

# BGE-M3 dense vectors (1024 dimensions); a local model directory is also supported.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_REVISION=main
EMBEDDING_DEVICE=cpu
EMBEDDING_USE_FP16=false
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_LENGTH=8192
EMBEDDING_CACHE_DIR=data/cache/models
EMBEDDING_LOCAL_FILES_ONLY=false

RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_REVISION=main
RERANKER_DEVICE=cpu
RERANKER_USE_FP16=false
RERANKER_BATCH_SIZE=4
RERANKER_MAX_LENGTH=1024
RERANKER_CACHE_DIR=data/cache/models
RERANKER_LOCAL_FILES_ONLY=false

# Identity (development keeps the local-only identity adapter; enable OIDC for shared environments)
ENVIRONMENT=development
AUTH_ENABLED=false
OIDC_ISSUER=
OIDC_AUDIENCE=evidencepilot-api
OIDC_JWKS_URL=

# Durable task queue (enable for production; requires Redis, dispatcher and Celery workers)
TASK_QUEUE_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
TASK_QUEUE_DISPATCH_INTERVAL_SECONDS=1
TASK_QUEUE_BATCH_SIZE=20
TASK_QUEUE_MAX_ATTEMPTS=10

# Development startup migration; production runs `alembic upgrade head` as a deployment step
DB_AUTO_MIGRATE=true

# Internal Prometheus metrics and local monitoring UI
METRICS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_password
