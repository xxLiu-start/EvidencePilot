# Streamlit OIDC configuration example. Copy to .streamlit/secrets.toml locally.
# Never commit actual client_secret or cookie_secret.
#
# The IdP client must be confidential, allow authorization-code redirect to
# http://localhost:8501/oauth2callback, and issue ACCESS tokens whose audience
# includes the FastAPI OIDC_AUDIENCE (evidencepilot-api).
#
# For production use HTTPS and the public Streamlit hostname in redirect_uri.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "REPLACE_WITH_LONG_RANDOM_SECRET"
expose_tokens = ["access"]
client_id = "evidencepilot-streamlit"
client_secret = "REPLACE_WITH_IDP_CLIENT_SECRET"
server_metadata_url = "http://localhost:8080/realms/evidencepilot/.well-known/openid-configuration"
